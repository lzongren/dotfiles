#!/usr/bin/env bash
set -euo pipefail

if [ -n "${STUB_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$STUB_LOG"
fi

if [ "${1:-}" = --detach ]; then
  [ -n "${STUB_LOG:-}" ] && printf 'PWD=%s\n' "$PWD" >>"$STUB_LOG"
  name="${!#}"
  case "${DEVBOX_STUB_DETACH:-created}" in
    created) echo "created $name" ;;
    exists) echo "exists $name" ;;
    *)
      echo "devbox: could not start $name on stub-host" >&2
      exit 1
      ;;
  esac
  exit 0
fi

case "${1:-} ${2:-}" in
  'status --raw')
    case "${DEVBOX_STUB_MODE:-}" in
      unreachable)
        echo 'devbox: cannot reach stub-host' >&2
        exit 1
        ;;
      empty)
        echo 'No sessions.'
        ;;
      hang)
        sleep 5
        ;;
      crash)
        kill -SEGV $$
        ;;
      beside)
        cat "$(dirname "$0")/../fixtures/status-raw.txt"
        echo 'proj-a|0|1791741000|0|claude||/home/me/dotfiles/existing-proj'
        echo 'at-root|0|1791741000|0|zsh||/home/me/dotfiles'
        echo 'escapes|0|1791741000|0|zsh||/home/me/dotfiles/../../etc'
        ;;
      *)
        cat "$(dirname "$0")/../fixtures/status-raw.txt"
        ;;
    esac
    ;;
  'web --print-config')
    printf 'host\tstub-host\n'
    printf 'sync\tdotfiles\t%s\t/home/me/dotfiles\n' "${DEVBOX_STUB_ROOT:-/home/me/dotfiles}"
    printf 'sync\tapi\t/home/me/my api\t/home/me/work/api\n'
    printf 'ignore\tbuild/\n'
    printf 'artifact\tCR\t%s\n' 'https://code\.example\.com/reviews/CR-[0-9]+'
    ;;
  *)
    echo "devbox stub: unsupported: $*" >&2
    exit 64
    ;;
esac
