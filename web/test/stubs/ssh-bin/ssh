#!/bin/sh
case "$*" in
  *'python3 -I -c'*)
    cat >"${SSH_STUB_UPLOAD:-/dev/null}"
    reply='{"path": "/home/me/work/demo/shot.png"}'
    [ -n "${SSH_STUB_UPLOAD_REPLY:-}" ] && reply=$SSH_STUB_UPLOAD_REPLY
    printf '%s\n' "$reply"
    exit "${SSH_STUB_UPLOAD_EXIT:-0}"
    ;;
esac
script=$(cat)
if [ -n "${SSH_STUB_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$SSH_STUB_LOG"
  printf '%s\n' "$script" | head -n 1 >>"$SSH_STUB_LOG"
fi
case "$script" in
  *'"limit"'*) cat "$(dirname "$0")/../../fixtures/remote-file.json" ;;
  *) cat "$(dirname "$0")/../../fixtures/insights.json" ;;
esac
