#!/bin/bash
# devbox — connect to a remote dev host over mosh, auto-attaching a persistent
# tmux session. Your work runs THERE; local files are bridged via Mutagen
# (see remote-dev/README.md). Host comes from ~/.config/devbox/config (copy
# remote-dev/config.example); nothing host-specific lives in this repo.
#
# Pairs with `dev` (remote workspace launcher), or starts remote agent sessions
# directly with explicit `--cc` / `--codex` flags.
#
# Usage: devbox [session-name]            (remote shell; default session: main)
#        devbox --cc [session-name] [path]  (Claude Code on remote)
#        devbox --codex [session-name] [path]  (Codex on remote)
#        devbox list                     (show running sessions, don't connect)
#        devbox status                   (session table: state, idle, cmd, path)
#        devbox doctor [--require-agent cc|codex]  (readiness checks)
#        devbox sync [ls|add|rm]         (manage synced folders)
#        devbox --raw                    (plain mosh, no tmux)

# Load host config (gitignored, lives outside the repo). Only DEVBOX_HOST is
# needed here; mosh-server and tmux resolve on the remote PATH (~/.local/bin
# via .zshenv), so no host-specific paths are required.
DEVBOX_CONFIG="${DEVBOX_CONFIG:-$HOME/.config/devbox/config}"
# shellcheck source=/dev/null
[ -f "$DEVBOX_CONFIG" ] && . "$DEVBOX_CONFIG"
DEVBOX_HOST="${DEVBOX_HOST:-dev}"

# Transport: mosh needs a direct route to the host, while SSH can use any
# ProxyJump or ProxyCommand configured by the user. Probe direct TCP:22 access;
# fall back to SSH when mosh cannot reach the host. Override with
# DEVBOX_TRANSPORT=mosh|ssh in the config to skip auto-detection.
devbox_transport() {
  case "${DEVBOX_TRANSPORT:-}" in mosh | ssh)
    printf '%s' "$DEVBOX_TRANSPORT"
    return
    ;;
  esac
  local h
  h="$(ssh -G "$DEVBOX_HOST" 2>/dev/null | awk '/^hostname /{print $2; exit}')"
  if nc -z -G 2 "${h:-$DEVBOX_HOST}" 22 >/dev/null 2>&1; then printf 'mosh'; else printf 'ssh'; fi
}

devbox_agent_session_name() {
  local agent="$1" local_dir="$2" base
  base="$(basename "$local_dir")"
  case "$agent" in
    cc | claude) printf 'cc-%s' "$base" ;;
    codex) printf 'codex-%s' "$base" ;;
  esac
}

devbox_agent_command() {
  case "$1" in
    cc | claude)
      printf '%s' 'if command -v claude >/dev/null 2>&1 && claude --version >/dev/null 2>&1; then exec claude --continue; fi; printf "devbox: Claude Code is not installed or failed to start on this remote host.\n"; printf "devbox: install/fix claude on the remote, then run devbox --cc again.\n"; exec "${SHELL:-/bin/sh}" -l'
      ;;
    codex)
      printf '%s' 'if command -v codex >/dev/null 2>&1 && codex --version >/dev/null 2>&1; then exec codex resume --last; fi; printf "devbox: Codex is not installed or failed to start on this remote host.\n"; printf "devbox: install/fix codex on the remote, then run devbox --codex again.\n"; exec "${SHELL:-/bin/sh}" -l'
      ;;
  esac
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
  echo "  host: $DEVBOX_HOST  (config: $DEVBOX_CONFIG)"
  if [[ -n "${DEVBOX_SYNCS:-}" ]]; then
    echo "  synced folders (Mutagen):"
    while IFS='|' read -r name local remote; do
      [[ -n "$name" ]] && printf '    %-10s %s  ⇄  %s\n' "$name" "$local" "$remote"
    done <<<"$DEVBOX_SYNCS"
  fi
  exit 0
fi

if [[ "$1" == "doctor" || "$1" == "check" ]]; then
  shift
  REQUIRE_CC=0
  REQUIRE_CODEX=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --require-agent)
        [ "$#" -ge 2 ] || {
          echo "usage: devbox doctor [--require-agent cc|codex]" >&2
          exit 2
        }
        agent="$2"
        shift 2
        ;;
      --require-agent=*)
        agent="${1#*=}"
        shift
        ;;
      -h | --help)
        echo "usage: devbox doctor [--require-agent cc|codex]"
        echo "  Repeat --require-agent to require both remote agent CLIs."
        exit 0
        ;;
      *)
        echo "devbox doctor: unknown option: $1" >&2
        echo "usage: devbox doctor [--require-agent cc|codex]" >&2
        exit 2
        ;;
    esac
    case "$agent" in
      cc | claude) REQUIRE_CC=1 ;;
      codex) REQUIRE_CODEX=1 ;;
      *)
        echo "devbox doctor: unknown agent: $agent (expected cc or codex)" >&2
        exit 2
        ;;
    esac
  done

  # Failures are unavailable requirements. Warnings are degraded capabilities;
  # informational lines describe optional or normal runtime state.
  g=$'\033[32m'
  c=$'\033[36m'
  y=$'\033[33m'
  r=$'\033[31m'
  d=$'\033[2m'
  z=$'\033[0m'
  fails=0
  warnings=0
  optional_agents_unavailable=0
  pass() { printf '  %s[ok]%s %s\n' "$g" "$z" "$1"; }
  info() { printf '  %s[i]%s  %s\n' "$c" "$z" "$1"; }
  warn() {
    printf '  %s[!]%s  %s %s%s%s\n' "$y" "$z" "$1" "$d" "${2:-}" "$z"
    warnings=$((warnings + 1))
  }
  fail() {
    printf '  %s[x]%s  %s %s%s%s\n' "$r" "$z" "$1" "$d" "${2:-}" "$z"
    fails=$((fails + 1))
  }
  section() { printf '\n%s\n' "$1"; }
  agent_result() {
    local state="$1" required="$2" label="$3" mode="$4"
    case "$state" in
      OK) pass "$label available on remote PATH" ;;
      BROKEN)
        if [ "$required" -eq 1 ]; then
          fail "$label is installed but failed to start" "fix it before using devbox --$mode"
        else
          warn "$label is installed but failed to start" "optional; needed for devbox --$mode"
          optional_agents_unavailable=$((optional_agents_unavailable + 1))
        fi
        ;;
      *)
        if [ "$required" -eq 1 ]; then
          fail "$label is not installed on the remote" "required for devbox --$mode"
        else
          info "$label not installed (optional; needed for devbox --$mode)"
          optional_agents_unavailable=$((optional_agents_unavailable + 1))
        fi
        ;;
    esac
  }

  CONFIGURED_SYNCS=()
  while IFS='|' read -r sync_name _local_path _remote_path; do
    [ -n "$sync_name" ] && CONFIGURED_SYNCS+=("$sync_name")
  done <<<"${DEVBOX_SYNCS:-}"

  echo "devbox doctor - host: $DEVBOX_HOST"

  section "Core"
  command -v ssh >/dev/null && pass "SSH client available" || fail "SSH client missing"

  transport="$(devbox_transport)"
  section "Transport"
  if [ "$transport" = mosh ]; then
    pass "direct route selected (mosh)"
    command -v mosh >/dev/null && pass "local mosh client available" || fail "local mosh client missing" "install mosh or set DEVBOX_TRANSPORT=ssh"
  elif [ "${DEVBOX_TRANSPORT:-}" = ssh ]; then
    pass "SSH transport explicitly configured"
    info "mosh checks not required for SSH transport"
  else
    pass "SSH fallback selected (ProxyJump/ProxyCommand supported)"
    info "mosh checks skipped because no direct route was detected"
  fi

  # Gather remote state with one SSH connection using explicit connection and
  # keepalive limits. PROBE_OK distinguishes valid state from unrelated output.
  PROBE_OK=""
  UP=""
  TMUX=""
  MOSH=""
  CLAUDE=""
  CODEX=""
  DISK=""
  SESSIONS=""
  ORPHANS=""
  probe=""
  ssh_completed=0
  remote_ok=0
  # shellcheck disable=SC2016  # command substitutions intentionally run remotely
  if probe="$(ssh \
    -o ConnectTimeout=10 \
    -o ConnectionAttempts=1 \
    -o ServerAliveInterval=5 \
    -o ServerAliveCountMax=2 \
    "$DEVBOX_HOST" '
      echo "PROBE_OK=1"
      echo "UP=$(uptime | sed "s/.* up /up /; s/, *[0-9][0-9]* user.*//")"
      echo "TMUX=$(command -v tmux || echo MISSING)"
      echo "MOSH=$(command -v mosh-server || echo MISSING)"
      echo "CLAUDE=$(if command -v claude >/dev/null 2>&1 && claude --version >/dev/null 2>&1; then echo OK; elif command -v claude >/dev/null 2>&1; then echo BROKEN; else echo MISSING; fi)"
      echo "CODEX=$(if command -v codex >/dev/null 2>&1 && codex --version >/dev/null 2>&1; then echo OK; elif command -v codex >/dev/null 2>&1; then echo BROKEN; else echo MISSING; fi)"
      echo "DISK=$(df -Pk "$HOME" 2>/dev/null | tail -1 | awk "{print \$5}" | tr -dc "0-9")"
      echo "SESSIONS=$(tmux list-sessions -F "." 2>/dev/null | wc -l | tr -d " ")"
      echo "ORPHANS=$(pgrep mosh-server 2>/dev/null | wc -l | tr -d " ")"
    ' 2>/dev/null)"; then
    ssh_completed=1
    while IFS='=' read -r k v; do
      case "$k" in
        PROBE_OK) PROBE_OK="$v" ;;
        UP) UP="$v" ;;
        TMUX) TMUX="$v" ;;
        MOSH) MOSH="$v" ;;
        CLAUDE) CLAUDE="$v" ;;
        CODEX) CODEX="$v" ;;
        DISK) DISK="$v" ;;
        SESSIONS) SESSIONS="$v" ;;
        ORPHANS) ORPHANS="$v" ;;
      esac
    done <<<"$probe"
    [ "$PROBE_OK" = 1 ] && remote_ok=1
  fi

  section "Remote"
  if [ "$remote_ok" -eq 1 ]; then
    pass "remote reachable (${UP:-uptime unavailable})"
    if [ "$TMUX" = MISSING ] || [ -z "$TMUX" ]; then
      fail "tmux not on remote PATH" "run setup-remote.sh; check ~/.zshenv"
    else
      pass "tmux available on remote PATH"
    fi

    if [ "$transport" = mosh ]; then
      [ "$MOSH" != MISSING ] && [ -n "$MOSH" ] && pass "mosh-server available on remote PATH" || fail "mosh-server not on remote PATH" "run setup-remote.sh or set DEVBOX_TRANSPORT=ssh"
    elif [ "$MOSH" != MISSING ] && [ -n "$MOSH" ]; then
      info "mosh-server available (not required for SSH transport)"
    else
      info "mosh-server not installed (not required for SSH transport)"
    fi

    case "$DISK" in
      "" | *[!0-9]*) warn "remote disk usage unavailable" ;;
      *)
        if [ "$DISK" -ge 95 ]; then
          fail "remote disk ${DISK}% full" "clean up space before tmux, mosh, or sync fail"
        elif [ "$DISK" -ge 85 ]; then
          warn "remote disk ${DISK}% full" "getting tight"
        else
          pass "remote disk ${DISK}% used"
        fi
        ;;
    esac
  elif [ "$ssh_completed" -eq 1 ]; then
    fail "remote probe returned an invalid response" "verify the remote login shell does not alter non-interactive output"
  else
    fail "remote unreachable ($DEVBOX_HOST)" "run ssh $DEVBOX_HOST; check keys, SSH proxy/jump host, VPN, and host status"
  fi

  section "Agents"
  if [ "$remote_ok" -eq 1 ]; then
    agent_result "$CLAUDE" "$REQUIRE_CC" "Claude Code" cc
    agent_result "$CODEX" "$REQUIRE_CODEX" "Codex" codex
  else
    info "agent checks skipped because the remote probe failed"
  fi

  section "Runtime"
  if [ "$remote_ok" -ne 1 ]; then
    info "tmux runtime checks skipped because the remote probe failed"
  elif [ "$TMUX" = MISSING ] || [ -z "$TMUX" ]; then
    info "tmux runtime checks skipped because tmux is unavailable"
  else
    case "$SESSIONS" in
      "" | *[!0-9]*) warn "tmux session count unavailable" ;;
      0) info "no tmux sessions (normal; devbox <name> starts one)" ;;
      *) pass "$SESSIONS tmux session(s) alive" ;;
    esac
  fi
  if [ "$remote_ok" -eq 1 ] && [ "$transport" = mosh ]; then
    case "$ORPHANS" in
      "" | *[!0-9]*) warn "mosh-server process count unavailable" ;;
      *) [ "$ORPHANS" -gt 5 ] && warn "$ORPHANS mosh-server processes running" "clean up stale processes" ;;
    esac
  fi

  section "Sync"
  if [ "${#CONFIGURED_SYNCS[@]}" -eq 0 ]; then
    info "no syncs configured; Mutagen is not required"
  else
    MUTAGEN="$(command -v mutagen 2>/dev/null || true)"
    [ -z "$MUTAGEN" ] && [ -x "$HOME/bin/mutagen" ] && MUTAGEN="$HOME/bin/mutagen"
    if [ -z "$MUTAGEN" ]; then
      fail "Mutagen missing" "required by ${#CONFIGURED_SYNCS[@]} configured sync(s); run remote-dev/setup-sync.sh"
    elif "$MUTAGEN" daemon status >/dev/null 2>&1 || "$MUTAGEN" sync list >/dev/null 2>&1; then
      pass "Mutagen daemon running"
      for sync_name in "${CONFIGURED_SYNCS[@]}"; do
        block="$("$MUTAGEN" sync list "$sync_name" 2>/dev/null)"
        if [ -z "$block" ]; then
          fail "sync '$sync_name' not found" "run remote-dev/setup-sync.sh"
          continue
        fi
        conn="$(printf '%s\n' "$block" | grep -c 'Connected: Yes')"
        status="$(printf '%s\n' "$block" | grep -m1 'Status:' | sed 's/.*Status: *//')"
        if [ "$conn" -ge 2 ]; then
          pass "sync '$sync_name' connected (${status:-status unavailable})"
        else
          fail "sync '$sync_name' not connected" "status: ${status:-unknown}; mutagen sync reset $sync_name"
        fi
      done
    else
      fail "Mutagen daemon not running" "run mutagen daemon start"
    fi
  fi

  echo
  if [ "$fails" -eq 0 ]; then
    if [ "$warnings" -eq 0 ]; then
      printf '%sREADY - all required checks passed.%s\n' "$g" "$z"
    else
      printf '%sREADY - all required checks passed with %d warning(s).%s\n' "$y" "$warnings" "$z"
    fi
    [ "$optional_agents_unavailable" -gt 0 ] && printf 'Optional agent capabilities unavailable: %d.\n' "$optional_agents_unavailable"
    exit 0
  fi
  printf '%sNOT READY - %d required check(s) failed.%s\n' "$r" "$fails" "$z"
  [ "$optional_agents_unavailable" -gt 0 ] && printf 'Optional agent capabilities unavailable: %d.\n' "$optional_agents_unavailable"
  exit 1
fi

if [[ "$1" == "sync" ]]; then
  # Manage synced folders. Config mutation lives in lib.sh (devbox_config_*),
  # which is what the bats tests exercise; this wrapper adds arg parsing, ~
  # expansion, and applying/terminating the live Mutagen session.
  _lib="$(cd "$(dirname "$0")/../remote-dev" 2>/dev/null && pwd)/lib.sh"
  if [ ! -f "$_lib" ]; then
    echo "devbox: cannot find remote-dev/lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$_lib"
  MUT="$(devbox_mutagen)"

  case "${2:-ls}" in
    ls | list | "")
      if ! devbox_syncs_list "$DEVBOX_CONFIG" | grep -q .; then
        echo "No synced folders configured."
        exit 0
      fi
      printf '%-12s %-40s %s\n' NAME LOCAL REMOTE
      devbox_syncs_list "$DEVBOX_CONFIG" | while IFS='|' read -r n l r; do printf '%-12s %-40s %s\n' "$n" "$l" "$r"; done
      ;;

    add)
      name="${3:-}"
      local_path="${4:-}"
      remote="${5:-${3:-}}" # default remote = name
      [ -n "$name" ] && [ -n "$local_path" ] || {
        echo "usage: devbox sync add <name> <local-path> [remote-path]" >&2
        exit 1
      }
      local_path="${local_path/#\~/$HOME}" # expand leading ~
      [ -d "$local_path" ] || {
        echo "devbox: local path not a directory: $local_path" >&2
        exit 1
      }
      devbox_config_add "$DEVBOX_CONFIG" "$name" "$local_path" "$remote" || exit 1
      echo "✓ added '$name' to $DEVBOX_CONFIG"
      if [ -n "$MUT" ]; then
        DEVBOX_SYNCS="" # reload for devbox_sync_create
        # shellcheck source=/dev/null
        . "$DEVBOX_CONFIG"
        devbox_sync_create "$name" "$local_path" "$remote" && echo "✓ sync '$name' created" ||
          echo "devbox: added to config but sync create failed — run remote-dev/setup-sync.sh" >&2
      else
        echo "devbox: mutagen not installed; run remote-dev/setup-sync.sh to apply" >&2
      fi
      ;;

    rm | remove | delete)
      name="${3:-}"
      [ -n "$name" ] || {
        echo "usage: devbox sync rm <name>" >&2
        exit 1
      }
      devbox_config_rm "$DEVBOX_CONFIG" "$name" || exit 1
      echo "✓ removed '$name' from $DEVBOX_CONFIG"
      # Terminate the live session (leaves files in place on both sides).
      [ -n "$MUT" ] && "$MUT" sync terminate "$name" 2>/dev/null && echo "✓ sync '$name' terminated (files kept on both sides)"
      ;;

    *)
      echo "usage: devbox sync [ls|add <name> <local> [remote]|rm <name>]" >&2
      exit 1
      ;;
  esac
  exit 0
fi

if [[ "$1" == "list" || "$1" == "ls" ]]; then
  # Quick query, no mosh/attach. A missing tmux server only means there are no
  # sessions yet; surface that cleanly instead of leaking tmux's socket error.
  if list_out="$(ssh "$DEVBOX_HOST" tmux ls 2>&1)"; then
    printf '%s\n' "$list_out"
    exit 0
  fi
  case "$list_out" in
    *"error connecting to "* | *"no server running on "* | *"failed to connect to server"*)
      echo "No sessions."
      exit 0
      ;;
    *)
      echo "$list_out" >&2
      exit 1
      ;;
  esac
fi

if [[ "$1" == "status" ]]; then
  # Status: one line per session (name|attached|activity|bell|cmd|path).
  # --raw: skip the pretty table, emit raw pipe-delimited lines for scripts.
  _lib="$(cd "$(dirname "$0")/../remote-dev" 2>/dev/null && pwd)/lib.sh"
  # shellcheck source=/dev/null
  [ -f "$_lib" ] && . "$_lib"
  # `true` last: ssh reports the LAST remote command's status, and both tmux
  # calls fail when no server runs — a reachable host with zero sessions must
  # not look like an unreachable one.
  probe="$(timeout 10 ssh -o ConnectTimeout=5 "$DEVBOX_HOST" '
    tmux list-sessions -F "S|#{session_name}|#{session_attached}|#{session_activity}" 2>/dev/null
    tmux list-panes -a -F "P|#{session_name}|#{window_active}|#{pane_active}|#{window_bell_flag}|#{pane_current_command}|#{pane_current_path}" 2>/dev/null
    true
  ' 2>/dev/null)" || {
    echo "devbox: cannot reach $DEVBOX_HOST" >&2
    exit 1
  }
  [ -z "$probe" ] && {
    echo "No sessions."
    exit 0
  }
  merged="$(printf '%s\n' "$probe" | devbox_status_lines)"
  if [[ "${2:-}" == "--raw" ]]; then
    printf '%s\n' "$merged"
  elif [[ "${2:-}" == "--summary" ]]; then
    # Natural language summary via claude (requires claude CLI on PATH).
    now="$(date +%s)"
    table=""
    while IFS='|' read -r name att act bell cmd path; do
      [ -n "$name" ] || continue
      idle="$(devbox_ago "$now" "$act")"
      att_str="attached"
      [ "$att" = 0 ] && att_str="detached"
      bell_str=""
      [ "$bell" = 1 ] && bell_str=" [NEEDS ATTENTION]"
      table+="- ${name}: ${att_str}, idle ${idle}, running ${cmd:-shell} in ${path}${bell_str}"$'\n'
    done <<<"$merged"
    printf '%s\n' "$table" | claude --model haiku -p \
      'Summarize these tmux sessions in 1-2 sentences for a developer checking in after a break. Be specific about what work seems active. Sessions marked NEEDS ATTENTION rang their bell (e.g. a command finished or wants input). No preamble.' 2>/dev/null ||
      printf '%s' "$table"
  else
    now="$(date +%s)"
    printf '%-20s %-6s %-6s %-4s %-10s %s\n' SESSION STATE IDLE BELL CMD PATH
    while IFS='|' read -r name att act bell cmd path; do
      [ -n "$name" ] || continue
      state="●"
      [ "$att" = 0 ] && state="○"
      idle="$(devbox_ago "$now" "$act")"
      bell_s=""
      [ "$bell" = 1 ] && bell_s="🔔"
      printf '%-20s %-6s %-6s %-4s %-10s %s\n' "$name" "$state" "$idle" "$bell_s" "$cmd" "$path"
    done <<<"$merged"
  fi
  exit 0
fi

if [[ "$1" == "--raw" ]]; then
  if [ "$(devbox_transport)" = mosh ]; then
    exec mosh "$DEVBOX_HOST"
  fi
  echo "devbox: direct mosh route unavailable; using plain ssh" >&2
  exec ssh -t "$DEVBOX_HOST"
fi

AGENT_MODE=""
LOCAL_DIR="$PWD"

case "${1:-}" in
  --cc | --claude | --codex)
    case "$1" in
      --cc | --claude) AGENT_MODE="cc" ;;
      --codex) AGENT_MODE="codex" ;;
    esac
    shift
    if [ "$#" -gt 2 ]; then
      echo "usage: devbox --$AGENT_MODE [session-name] [path]" >&2
      exit 1
    fi
    if [ "$#" -ge 1 ]; then
      SESSION="$1"
      shift
    else
      SESSION=""
    fi
    if [ "$#" -ge 1 ]; then
      LOCAL_DIR="${1/#\~/$HOME}"
      shift
    fi
    LOCAL_DIR="$(realpath "$LOCAL_DIR" 2>/dev/null)" || {
      echo "devbox: cannot resolve path: $LOCAL_DIR" >&2
      exit 1
    }
    [ -d "$LOCAL_DIR" ] || {
      echo "devbox: path is not a directory: $LOCAL_DIR" >&2
      exit 1
    }
    [ -n "$SESSION" ] || SESSION="$(devbox_agent_session_name "$AGENT_MODE" "$LOCAL_DIR")"
    ;;
  *) SESSION="${1:-main}" ;;
esac

# If launched from within a synced folder, open the remote session in the
# corresponding remote dir. Only affects NEW sessions (-c is ignored when -A
# re-attaches an existing one, so reconnecting never jumps you elsewhere).
CDIR=""
_lib="$(cd "$(dirname "$0")/../remote-dev" 2>/dev/null && pwd)/lib.sh"
if [ -f "$_lib" ]; then
  # shellcheck source=/dev/null
  . "$_lib"
  rhome="$(devbox_remote_home 2>/dev/null)" &&
    CDIR="$(devbox_remote_dir "$DEVBOX_CONFIG" "$LOCAL_DIR" "$rhome")"
fi

# tmux args as an array so both transports run the identical remote command.
TMUX_CMD=(tmux new-session -A -s "$SESSION")
[ -n "$CDIR" ] && TMUX_CMD+=(-c "$CDIR")
[ -n "$AGENT_MODE" ] && TMUX_CMD+=("$(devbox_agent_command "$AGENT_MODE")")

if [ "$(devbox_transport)" = mosh ]; then
  exec mosh "$DEVBOX_HOST" -- "${TMUX_CMD[@]}"
fi
# SSH may use a ProxyJump or ProxyCommand from ~/.ssh/config. Sessions survive
# identically (tmux lives on the remote); only mosh's roaming is unavailable.
# Force UTF-8 locale: mosh validates this at protocol level, but plain ssh
# inherits the remote's bare POSIX locale, making tmux render unicode as '_'.
echo "devbox: direct mosh route unavailable; using ssh + tmux" >&2
exec ssh -t "$DEVBOX_HOST" env LANG=C.UTF-8 "${TMUX_CMD[@]}"
