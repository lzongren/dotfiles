#!/bin/bash
# dev — open a project workspace with claude, yazi, and lazygit
# Usage: dev [path]

_DEV_SOURCE="$0"
while [ -L "$_DEV_SOURCE" ]; do
  _DEV_SOURCE_DIR="$(cd -P "$(dirname "$_DEV_SOURCE")" && pwd)"
  _DEV_TARGET="$(readlink "$_DEV_SOURCE")"
  case "$_DEV_TARGET" in /*) _DEV_SOURCE="$_DEV_TARGET" ;; *) _DEV_SOURCE="$_DEV_SOURCE_DIR/$_DEV_TARGET" ;; esac
done
_DEV_BIN_DIR="$(cd -P "$(dirname "$_DEV_SOURCE")" && pwd)"
_DEV_VERSION_LIB="$_DEV_BIN_DIR/../lib/dotfiles-tools-version.sh"
# shellcheck source=/dev/null
[ -f "$_DEV_VERSION_LIB" ] && . "$_DEV_VERSION_LIB"

if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  if declare -F dotfiles_tools_print_version >/dev/null 2>&1; then
    dotfiles_tools_print_version dev "$_DEV_SOURCE"
  else
    echo "dev unknown"
  fi
  exit 0
fi

DIR=$(realpath "${1:-$PWD}")
BASENAME=$(basename "$DIR")
DISPLAY_PATH="~${DIR#"$HOME"}"
SESSION="$BASENAME - $DISPLAY_PATH"

# Attach to existing session if it already exists
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  tmux attach -t "=$SESSION"
  exit 0
fi

# Create new session, main pane: claude
tmux new-session -d -s "$SESSION" -c "$DIR"
tmux send-keys -t "$SESSION:0.0" "claude --resume" Enter

# Right split: yazi
tmux split-window -h -t "$SESSION:0.0" -c "$DIR" -p 30
tmux send-keys -t "$SESSION:0.1" "yazi" Enter

# Below yazi: lazygit
tmux split-window -v -t "$SESSION:0.1" -c "$DIR"
tmux send-keys -t "$SESSION:0.2" "lazygit" Enter

# Focus back to claude (left pane)
tmux select-pane -t "$SESSION:0.0"

tmux attach -t "$SESSION"
