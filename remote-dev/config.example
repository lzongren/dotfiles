# devbox config — copy to ~/.config/devbox/config and fill in your values.
# Keeps host/user/paths OUT of the (public) dotfiles repo. Sourced by devbox
# and the setup scripts. All values optional; sensible defaults apply.

# SSH host (a Host entry in ~/.ssh/config, or user@hostname)
DEVBOX_HOST="my-dev-host"

# Remote home directory. Leave unset to auto-detect via `ssh $DEVBOX_HOST 'echo $HOME'`.
# DEVBOX_REMOTE_HOME="/home/me"

# Transport: leave unset to auto-detect (mosh when the host is directly
# reachable, ssh+tmux otherwise; SSH may use ProxyJump or ProxyCommand).
# Set to force one: mosh | ssh
# DEVBOX_TRANSPORT="mosh"

# Folders to two-way sync, one per line: "name|local-path|remote-path"
# remote-path is relative to the remote home unless absolute.
DEVBOX_SYNCS="
work|$HOME/Documents/work|work
notes|$HOME/Documents/notes|notes
"

# Links `devbox web` lists as a session's artifacts, one per line:
# "label|regex" (Python syntax), or "label|regex|link" for ids printed
# without a URL: the link must contain {0}, which becomes the match. GitHub pull
# requests are always found.
# DEVBOX_ARTIFACTS="
# MR|https://gitlab\.example\.com/\S+?/-/merge_requests/[0-9]+
# TICKET|TICKET-[0-9]+|https://tickets.example.com/browse/{0}
# "

# Local web dashboard port for `devbox web`. Default 7733.
# DEVBOX_WEB_PORT="7733"
